          "content": {
            "size": 2546,
            "mimeType": "application/json",
            "text": "{\"_links\":{\"first\":false,\"prev\":false,\"self\":\"v1/administracao/mensagens-erro?modulo=COMPRA\",\"next\":false,\"last\":false,\"page\":1,\"per_page\":20,\"total_pages\":1,\"count\":7},\"data\":[{\"id\":\"25\",\"chave\":\"001\",\"modulo\":\"COMPRA\",\"mensagem\":\"O arquivo XML da nota fiscal parece estar com algum erro em sua estrutura. Recomendamos que entre em contato com o emissor da nota para verificar o problema.\",\"status\":\"REV\",\"status_formatado\":\"Revisada\",\"link\":\"http://suporte.simples.vet/produtos-e-servicos/compras-manual-e-xml/arquivo-xml-da-nota-de-compra-possui-estrutura-incorreta\",\"data_inclusao\":\"2018-07-23 16:41:56\"},{\"id\":\"27\",\"chave\":\"002\",\"modulo\":\"COMPRA\",\"mensagem\":\"O valor total desta compra é R$ 0,00, por isso o lançamento referente a ela será removido do financeiro.\",\"status\":\"REV\",\"status_formatado\":\"Revisada\",\"link\":null,\"data_inclusao\":\"2018-08-24 18:01:37\"},{\"id\":\"28\",\"chave\":\"003\",\"modulo\":\"COMPRA\",\"mensagem\":\"Você está inserindo uma compra com valor total de R$ 0,00, por isso não será criado um lançamento financeiro para ela.\",\"status\":\"REV\",\"status_formatado\":\"Revisada\",\"link\":null,\"data_inclusao\":\"2018-08-24 18:04:03\"},{\"id\":\"29\",\"chave\":\"004\",\"modulo\":\"COMPRA\",\"mensagem\":\"Existe um ou mais produtos cadastrados com custo R$ 0,00. Deseja salvar mesmo assim?\",\"status\":\"REV\",\"status_formatado\":\"Revisada\",\"link\":null,\"data_inclusao\":\"2018-08-24 18:07:36\"},{\"id\":\"30\",\"chave\":\"005\",\"modulo\":\"COMPRA\",\"mensagem\":\"Não é possível atualizar esta compra para o valor R$ 0,00 pois já existem lançamentos baixados para ela no financeiro.\",\"status\":\"REV\",\"status_formatado\":\"Revisada\",\"link\":null,\"data_inclusao\":\"2018-08-29 15:46:54\"},{\"id\":\"31\",\"chave\":\"006\",\"modulo\":\"COMPRA\",\"mensagem\":\"Compra não integrada ao financeiro.\",\"status\":\"REV\",\"status_formatado\":\"Revisada\",\"link\":\"http://suporte.simples.vet/produtos-e-servicos/quando-uma-compra-nao-e-integrada-ao-financeiro\",\"data_inclusao\":\"2018-08-29 16:55:16\"},{\"id\":\"69\",\"chave\":\"007\",\"modulo\":\"COMPRA\",\"mensagem\":\"Esse é o <b>custo de aquisição</b> do produto e é muito importante conhecê-lo para que você possa calcular de forma correta o seu preço de venda. Passe o mouse sobre os valores para ver o detalhamento.\",\"status\":\"REV\",\"status_formatado\":\"Revisada\",\"link\":\"https://suporte.simples.vet/produtos-e-servicos/custo-de-aquisicao-dos-produtos-nas-compras-importadas-por-xml-disponivel-apenas-em-beta\",\"data_inclusao\":\"2018-12-28 13:52:02\"}],\"code\":200}"
