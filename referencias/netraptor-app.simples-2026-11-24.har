            "text": "{\"_links\":{\"first\":false,\"prev\":false,\"self\":\"v1/administracao/configuracao-campos-obrigatorios?tipo=PES\",\"next\":false,\"last\":false,\"page\":1,\"per_page\":20,\"total_pages\":0,\"count\":0},\"data\":[{\"campos\":{\"DADOS_GERAIS\":{\"DESCRICAO\":\"\",\"CAMPOS\":{\"NOME_COMPLETO\":{\"id\":\"pes_var_nome\",\"titulo\":\"Nome completo\",\"obrigatorio\":true,\"status\":false},\"NACIONALIDADE\":{\"id\":\"pes_var_pais\",\"titulo\":\"Nacionalidade\",\"obrigatorio\":true,\"status\":false},\"SEXO\":{\"id\":\"pes_cha_sexo\",\"titulo\":\"Sexo\",\"obrigatorio\":false,\"status\":true},\"TIPO\":{\"id\":\"pes_cha_tipo\",\"titulo\":\"Tipo (Pessoas Física / Jurídica)\",\"obrigatorio\":true,\"status\":false},\"CPF\":{\"id\":\"pes_var_cpf\",\"titulo\":\"CPF\",\"obrigatorio\":false,\"status\":true},\"RG\":{\"id\":\"pes_var_rg\",\"titulo\":\"RG\",\"obrigatorio\":false,\"status\":true},\"ANIVERSARIO\":{\"id\":\"pes_var_aniversario\",\"titulo\":\"Aniversário\",\"obrigatorio\":false,\"status\":true},\"COMO_NOS_CONHECEU\":{\"id\":\"ope_int_codigo\",\"titulo\":\"Como nos conheceu?\",\"obrigatorio\":false,\"status\":true},\"PROFISSAO\":{\"id\":\"prf_int_codigo\",\"titulo\":\"Profissão\",\"obrigatorio\":false,\"status\":true}}},\"CONTATOS\":{\"DESCRICAO\":\"Para o envio das mensagens, é obrigatório informar ao menos um contato no cadastro do clientre. Defina abaixo quais contatos são obrigatórios.\",\"CAMPOS\":{\"EMAIL\":{\"id\":\"5\",\"titulo\":\"E-mail\",\"obrigatorio\":false,\"status\":true},\"CELULAR\":{\"id\":\"1\",\"titulo\":\"Celular\",\"obrigatorio\":false,\"status\":true},\"TELEFONE_RESIDENCIAL\":{\"id\":\"2\",\"titulo\":\"Telefone residencial\",\"obrigatorio\":false,\"status\":true},\"TELEFONE_COMERCIAL\":{\"id\":\"3\",\"titulo\":\"Telefone comercial\",\"obrigatorio\":false,\"status\":true},\"OUTROS_CONTATOS\":{\"id\":\"4\",\"titulo\":\"Outros contatos\",\"obrigatorio\":false,\"status\":true}}},\"ENDERECO\":{\"DESCRICAO\":\"Ao marcar o endereço como obrigatório, os seguintes dados deverão ser preenchidos. CEP, Rua, Número, Bairro, Município e Estado.\",\"CAMPOS\":{\"ENDERECO\":{\"id\":\"end_var_endereco\",\"titulo\":\"Endereço\",\"obrigatorio\":false,\"status\":true},\"COMPLEMENTO\":{\"id\":\"end_var_complemento\",\"titulo\":\"Complemento\",\"obrigatorio\":false,\"status\":true},\"PONTO_DE_REFERENCIA\":{\"id\":\"end_var_referencia\",\"titulo\":\"Ponto de referência\",\"obrigatorio\":false,\"status\":true},\"CEP\":{\"id\":\"end_var_cep\",\"titulo\":\"CEP\",\"obrigatorio\":false,\"status\":true},\"NUMERO\":{\"id\":\"end_var_numero\",\"titulo\":\"Número\",\"obrigatorio\":false,\"status\":true},\"BAIRRO\":{\"id\":\"end_var_bairro\",\"titulo\":\"Bairro\",\"obrigatorio\":false,\"status\":true},\"CIDADE\":{\"id\":\"end_var_municipio\",\"titulo\":\"Cidade\",\"obrigatorio\":false,\"status\":true},\"ESTADO\":{\"id\":\"end_var_uf\",\"titulo\":\"Estado\",\"obrigatorio\":false,\"status\":true}}}}}],\"code\":200}"
